# 이 파일을 .env로 복사한 뒤 필요한 값만 입력하세요.
# 실제 API 키·토큰은 이 예시 파일에 저장하지 마세요.

# fake: 외부 API 없이 예제 실행 / ollama: 로컬 모델 / openai: OpenAI API
LLM_BACKEND=fake
SUPERVISOR_VERSION=v2

# OpenAI 모드에서만 필요합니다. 실제 키는 .env에 입력하세요.
OPENAI_API_KEY=

# 선택 사항: LangSmith 추적. 사용하려면 .env에서 활성화하고 키를 입력하세요.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=optics-lab
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
